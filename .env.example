# Copy to .env and fill in. .env is git-ignored and never committed.
GEMINI_API_KEY=
# Optional: another Gemini model, see triage/gemini.py PRICES for the priced ones
# GEMINI_MODEL=gemini-2.5-flash-lite
# Optional: use Claude instead
# ANTHROPIC_API_KEY=
# TRIAGE_PROVIDER=claude
# Or bring a Google Cloud project instead of a key (Vertex AI, uses gcloud application-default login)
# TRIAGE_GCP_PROJECT=
